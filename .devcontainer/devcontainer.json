{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": ["docker-compose.yaml"],
  "workspaceFolder": "/workspace",
  "service": "varist",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "halon.vscode-halon",
        "halon.hsl-syntax",
        "halon.hsl-linter",
        "halon.hsl-debug"
      ]
    }
  }
}
